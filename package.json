{
  "name": "pixelbolt",
  "version": "0.9.0",
  "description": "Agent-first pixel art and animation toolkit with a CLI, MCP server and local studio. Deterministic JSON recipes to PNG, APNG and sprite atlases; zero dependencies.",
  "homepage": "https://github.com/skulitom/Pixelbolt#readme",
  "repository": { "type": "git", "url": "git+https://github.com/skulitom/Pixelbolt.git" },
  "bugs": { "url": "https://github.com/skulitom/Pixelbolt/issues" },
  "keywords": ["pixel-art", "pixelart", "pixel-font", "sprites", "dithering", "particle-effects", "sprite-sheet", "sprite-animation", "texture-atlas", "game-assets", "gamedev", "mcp", "mcp-server", "model-context-protocol", "ai-agents", "agent-skills", "png", "apng", "gif", "image-sequence", "video", "cli", "zero-dependencies"],
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "pixelbolt": "./bin/pixelbolt.js", "pixelforge": "./bin/pixelforge.js" },
  "exports": { ".": "./src/index.js", "./core": "./src/core.js", "./runtime": "./src/runtime.js", "./authoring": "./src/authoring.js", "./scene": "./src/scene.js", "./autotile": "./src/autotile.js", "./fx": "./src/fx.js", "./fluid": "./src/fluid.js", "./craft": "./src/craft.js", "./gif": "./src/gif.js", "./font": "./src/font.js" },
  "files": ["bin", "src", "studio", "examples", "schema.json", "poses.schema.json", "scene.schema.json", "autotile.schema.json", "fx.schema.json", "fluid.schema.json", "normals.schema.json", "docs", "skills", "README.md", "README.zh-CN.md", "README.ja.md", "AGENTS.md", "CONTRIBUTING.md", "llms.txt", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "start": "node bin/pixelbolt.js preview",
    "demo": "node bin/pixelbolt.js render examples/forest-spirit.json --out output/forest-spirit",
    "play": "node scripts/serve-emberfall.mjs",
    "art:emberfall": "node scripts/build-emberfall.mjs --force",
    "stress:emberfall": "node scripts/stress-emberfall.mjs",
    "art:quality": "node scripts/build-quality-lab.mjs",
    "check:quality": "node scripts/build-quality-lab.mjs --check",
    "art:fluid": "node showcase/fluid/build.mjs",
    "check:fluid": "node showcase/fluid/build.mjs --check",
    "review:quality": "node bin/pixelbolt.js preview examples/quality/hollow.scene.json",
    "play:tidewatch": "node scripts/serve-tidewatch.mjs",
    "art:tidewatch": "node showcase/tidewatch/tools/build-assets.mjs",
    "check:tidewatch": "node showcase/tidewatch/tools/build-assets.mjs --check",
    "mcp": "node bin/pixelbolt.js mcp",
    "build:studio": "node scripts/build-studio.mjs",
    "check:studio": "node scripts/build-studio.mjs --check",
    "verify:studio": "node scripts/verify-studio.mjs",
    "qa:studio": "node scripts/qa-studio.mjs"
  }
}
