              },
              "y2": {
                "type": "number",
                "minimum": -4096,
                "maximum": 4096
              },
              "radius": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 64,
                "description": "Default 3."
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          },
          "wall": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": -4096,
                "maximum": 4096,
                "description": "Canvas pixels; quarter pixels are kept."
              },
              "y": {
                "type": "number",
                "minimum": -4096,
                "maximum": 4096
              },
              "x2": {
                "type": "number",
